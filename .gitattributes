* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.shader text eol=lf
*.png binary
*.gif binary
*.wav binary
# Unity serializes empty YAML fields with trailing spaces.
*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
